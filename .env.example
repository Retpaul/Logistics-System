DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/bike_dispatch?schema=public
PORT=8001
CLIENT_URL=http://localhost:5173
API_VERSION=/api/v1

# Rider invitation emails (required only when issuing/resending invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private S3 storage. See docs/STORAGE.md. Keep credentials server-side.
AWS_REGION=
AWS_S3_BUCKET=
# Optional: prefer AWS_PROFILE locally or an IAM role in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=             # required when using temporary access keys
# AWS_PROFILE=                   # local AWS CLI / SSO profile
S3_KEY_PREFIX=bike-dispatch
S3_MAX_FILE_SIZE_BYTES=10485760
S3_SIGNED_URL_TTL_SECONDS=900

# Signs access tokens. Required in production (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Optional overrides
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=false            # defaults to true when NODE_ENV=production
# TEST_DATABASE_URL=             # defaults to DATABASE_URL with the database renamed to bike_dispatch_test

# Future MongoDB import target; unused by current runtime and offline models.
MONGODB_URI=
