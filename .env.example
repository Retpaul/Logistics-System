DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/bike_dispatch?schema=public
PORT=8001
CLIENT_URL=http://localhost:5173
API_VERSION=/api/v1

# Signs access tokens. Required in production (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Optional overrides
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=false            # defaults to true when NODE_ENV=production
# TEST_DATABASE_URL=             # defaults to DATABASE_URL with the database renamed to bike_dispatch_test
