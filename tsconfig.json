{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "app.ts",
    "server.ts",
    "config/**/*.ts",
    "contracts/**/*.ts",
    "controllers/**/*.ts",
    "lib/**/*.ts",
    "middleware/**/*.ts",
    "repositories/**/*.ts",
    "routes/**/*.ts",
    "services/**/*.ts",
    "startup/**/*.ts",
    "types/**/*.d.ts"
  ]
}
