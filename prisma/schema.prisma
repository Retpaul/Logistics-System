generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  DISPATCHER
  RIDER
}

enum OrderStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
}

model Tenant {
  id        String @id @default(uuid()) @db.Uuid
  name      String @db.VarChar(150)
  subdomain String @unique @db.VarChar(63)
  tagline   String? @db.VarChar(200)
  logoUrl   String?
  brandColor String? @db.VarChar(7)
  secondaryColor String? @db.VarChar(7)
  currency  String @default("NGN") @db.VarChar(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  users User[]
  riders Rider[]
  bikes Bike[]
  customers Customer[]
  qrCodes QrCode[]
  orders Order[]
}

model User {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  email String @db.VarChar(254)
  passwordHash String
  firstName String @db.VarChar(80)
  lastName String @db.VarChar(80)
  role Role @default(DISPATCHER)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rider Rider?
  refreshTokens RefreshToken[]
  files StoredFile[]
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([email])                             // login looks a user up by email across tenants
}

// Opaque refresh tokens (only the SHA-256 hash is stored). Every rotation stays in one
// family; presenting an already-rotated token revokes the whole family (theft detection).
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  familyId String @db.Uuid
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  @@index([tenantId, userId])
  @@index([familyId])
}

model Rider {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String @unique @db.Uuid
  available Boolean @default(false)
  onboardingStatus String @default("PENDING") @db.VarChar(20)
  phone String? @db.VarChar(25)
  invitationHash String? @unique @db.Char(64)
  invitationExpiresAt DateTime? @db.Timestamptz(3)
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  locationAt DateTime? @db.Timestamptz(3)
  locationSource String? @db.VarChar(10)
  bikeSerial String? @db.VarChar(100)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  orders Order[]
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
}

model Bike {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  serialNumber String @db.VarChar(100)
  batteryPercent Int @default(100)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders Order[]
  @@unique([tenantId, serialNumber])
  @@unique([tenantId, id])
}

model Customer {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(150)
  phone String @db.VarChar(25)
  email String? @db.VarChar(254)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders Order[]
  @@unique([tenantId, id])
  @@index([tenantId, phone])
}

model QrCode {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code String @unique @default(uuid())
  label String @db.VarChar(150)
  campaign String? @db.VarChar(150)
  active Boolean @default(true)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders Order[]
  scans QrScan[]
  @@unique([tenantId, id])
}

model QrScan {
  id String @id @default(uuid()) @db.Uuid
  qrCodeId String @db.Uuid
  scannedAt DateTime @default(now()) @db.Timestamptz(3)
  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Restrict)
  @@index([qrCodeId, scannedAt])
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  customerId String @db.Uuid
  riderId String? @db.Uuid
  bikeId String? @db.Uuid
  qrCodeId String? @db.Uuid
  trackingCode String @unique @default(uuid())
  pickupAddress String
  deliveryAddress String
  recipientName String @db.VarChar(150)
  recipientPhone String @db.VarChar(25)
  packageSize PackageSize @default(MEDIUM)
  notes String? @db.VarChar(1000)
  status OrderStatus @default(PENDING)
  deliveryFee Decimal @db.Decimal(12, 2)
  currency String @default("NGN") @db.VarChar(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  pickedUpAt DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  proofFileId String? @db.Uuid
  proofRecipient String? @db.VarChar(150)
  pickupLatitude Decimal? @db.Decimal(9, 6)
  pickupLongitude Decimal? @db.Decimal(9, 6)
  deliveryLatitude Decimal? @db.Decimal(9, 6)
  deliveryLongitude Decimal? @db.Decimal(9, 6)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  rider Rider? @relation(fields: [tenantId, riderId], references: [tenantId, id], onDelete: Restrict)
  bike Bike? @relation(fields: [tenantId, bikeId], references: [tenantId, id], onDelete: Restrict)
  qrCode QrCode? @relation(fields: [tenantId, qrCodeId], references: [tenantId, id], onDelete: Restrict)
  events OrderEvent[]
  locations TrackingPoint[]
  payments Payment[]
  @@index([tenantId, status, createdAt])
  // Query-performance indexes: evidence in docs/PERFORMANCE.md.
  @@index([tenantId, createdAt])               // newest-first lists, date ranges, KPIs (Q03, Q04, Q08, Q09)
  @@index([tenantId, deliveredAt])             // exact delivery-day totals
  @@index([tenantId, customerId])
  @@index([tenantId, riderId, createdAt])      // replaces (tenantId, riderId): rider filter ordered by date (Q06)
  @@index([tenantId, bikeId])
  @@index([tenantId, qrCodeId, createdAt])     // replaces (tenantId, qrCodeId): QR conversions by date (Q11)
  @@index([tenantId, recipientPhone])          // dispatcher phone search (Q13)
}

// Private file ownership is checked before signing; resource linking is controlled by services.
model StoredFile {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  key String @unique
  filename String @db.VarChar(120)
  contentType String @db.VarChar(127)
  size Int
  purpose String @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  @@index([tenantId, userId, purpose])
}

model OrderEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  status OrderStatus
  note String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, status, createdAt])        // replaces (orderId, createdAt): index-only status lookups (Q10)
}

model TrackingPoint {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  latitude Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  source String @default("LEGACY") @db.VarChar(10)
  accuracy Float?
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, recordedAt])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  providerReference String? @unique
  amount Decimal @db.Decimal(12, 2)
  currency String @default("NGN") @db.VarChar(3)
  status PaymentStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}
